# Bedrock Mantle credentials — loaded automatically by kitin-server.
# Copy to ~/.kitin/env or .env in the project root:
#   cp .env.example ~/.kitin/env
#
OPENAI_BASE_URL=https://bedrock-mantle.us-east-1.api.aws/v1
OPENAI_API_KEY=your-bedrock-api-key-here

# SMTP — required to email scan reports (recipient is set in ~/.kitin/config.json)
# KITIN_SMTP_HOST=smtp.gmail.com
# KITIN_SMTP_PORT=587
# KITIN_SMTP_USER=you@gmail.com
# KITIN_SMTP_PASS=your-app-password
# KITIN_SMTP_FROM=kitin <you@gmail.com>
